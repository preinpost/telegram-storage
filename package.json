{
  "name": "telegram-storage",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram-based unlimited file storage (M1+M2): Hono + TypeScript backend, SQLite metadata, 15MB chunks, mock Telegram client for token-less verification",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx scripts/smoke.ts",
    "chatid": "tsx scripts/chatid.ts"
  },
  "dependencies": {
    "@fastify/busboy": "^3.1.1",
    "@grammyjs/auto-retry": "^1.0.1",
    "@grammyjs/transformer-throttler": "^0.1.1",
    "@hono/node-server": "^1.14.0",
    "better-sqlite3": "^11.10.0",
    "grammy": "^1.34.1",
    "hono": "^4.8.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
