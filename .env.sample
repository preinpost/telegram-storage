# ============================================================
# telegram-storage — 개발용 샘플 환경 설정 (.env.sample)
#
# 사용법:
#   cp .env.sample .env
#   task dev:all
#
# 이 파일은 "바로 실행되는" 개발용 샘플입니다.
# 빈 템플릿(주석만 있는 버전)은 .env.example 을 참고하세요.
# 실전 배포 시: DEV_AUTH=false, COOKIE_SECURE=true, SESSION_SECRET 고정
# ============================================================

# --- Telegram (REAL 모드에서만 필요 — 샘플은 MOCK 모드) ---
# @BotFather 에서 발급받은 봇 토큰. 비워두면 MOCK 모드로 동작합니다.
# 실전 예: TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_BOT_TOKEN=
# @BotFather 봇 유저네임 (텔레그램 로그인 위젯용).
# 실전 예: TELEGRAM_BOT_USERNAME=my_storage_bot
TELEGRAM_BOT_USERNAME=
# 전용 비공개 채널 chat id (mock 모드에서는 불필요).
# 실전 예: STORAGE_CHAT_ID=-1001234567890
STORAGE_CHAT_ID=

# --- 인증 / 세션 ---
# 세션 쿠키 서명 비밀키. 개발용 샘플 값 — 실전에선 반드시 랜덤 고정값으로.
SESSION_SECRET=dev-sample-secret-change-me
# 개발용: 텔레그램 위젯 없이 username 으로 로그인 (첫 계정 = admin)
DEV_AUTH=true
# 로그인 rate limit (IP당 분당, 0=비활성)
RATE_LIMIT_PER_MINUTE=10
# HTTPS 배포 시 true. 로컬 HTTP 개발은 false 유지.
COOKIE_SECURE=false

# --- 저장소 ---
DB_PATH=./data/telegram-storage.db
TMP_DIR=./tmp
# 다운로드 디스크 캐시 (비우면 비활성). 테스트해보려면: CACHE_DIR=./tmp/cache
CACHE_DIR=
CACHE_MAX_MB=1024

# --- 속도제한 큐 ---
# Telegram API 호출 사이 최소 간격(ms). mock 모드에선 크게 무관 (개발 속도 UP: 0~50)
QUEUE_INTERVAL_MS=50
QUEUE_MAX_RETRIES=4
QUEUE_BASE_BACKOFF_MS=1000
QUEUE_MAX_BACKOFF_MS=60000

# --- 서버 ---
HOST=0.0.0.0
PORT=3000
# 빌드된 SPA 서빙 디렉터리 (web/dist). Docker 단일 컨테이너 배포에서 사용.
STATIC_DIR=./web/dist

# --- 스모크 테스트 ---
SMOKE_FILE_SIZE_MB=32
SMOKE_QUEUE_INTERVAL_MS=50
SMOKE_DB_PATH=./tmp/smoke.db
