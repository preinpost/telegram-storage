# ============================================================
# telegram-storage 환경 설정
# `.env` 로 복사한 뒤 값을 채우세요. (모두 선택 사항 — 토큰이 없으면
# mock Telegram 클라이언트로 전체 동작이 검증됩니다)
# ============================================================

# --- Telegram (REAL 모드에서만 필요) ---
# @BotFather 에서 발급받은 봇 토큰. 비워두면 MOCK 모드로 동작합니다.
TELEGRAM_BOT_TOKEN=
# 전용 비공개 채널/그룹의 chat id (예: -1001234567890 또는 @username).
# MOCK 모드에서는 없어도 됩니다.
STORAGE_CHAT_ID=

# --- 저장소 ---
# SQLite DB 경로 (data/ 는 .gitignore 에 포함)
DB_PATH=./data/telegram-storage.db
# 임시 파일 디렉터리 (업로드 스풀, mock Telegram 저장소)
TMP_DIR=./tmp

# --- 속도제한 큐 ---
# Telegram API 호출 사이 최소 간격(ms). 1000 = 초당 1회 (개인 채팅 기준 안전값.
# 그룹/채널은 분당 20회 허용이므로 3000 이상으로도 조정 가능)
QUEUE_INTERVAL_MS=1000
# 429(flood control) 발생 시 재시도 횟수 (첫 시도 이후 추가 시도)
QUEUE_MAX_RETRIES=4
# 지수 백오프 기본값(ms): 지연 = base * 2^(시도-1)
QUEUE_BASE_BACKOFF_MS=1000
# 백오프 상한(ms)
QUEUE_MAX_BACKOFF_MS=60000

# --- 서버 ---
HOST=0.0.0.0
PORT=3000

# --- 스모크 테스트 ---
# mock 모드 기본 32MB, REAL 모드 기본 8MB. 100MB+ 검증: SMOKE_FILE_SIZE_MB=120
SMOKE_FILE_SIZE_MB=32
# 스모크용 큐 간격(ms). mock 모드 기본 50ms (빠른 검증), REAL 모드 기본 1000ms
SMOKE_QUEUE_INTERVAL_MS=50
SMOKE_DB_PATH=./tmp/smoke.db
